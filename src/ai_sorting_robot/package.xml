<?xml version="1.0"?>
<package format="3">
  <name>ai_sorting_robot</name>
  <version>0.1.0</version>
  <description>Natural-language sorting robot simulation for ROS 2 and Gazebo.</description>
  <maintainer email="student@example.com">honor</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>linkattacher_msgs</exec_depend>
  <exec_depend>ros2srrc_data</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
